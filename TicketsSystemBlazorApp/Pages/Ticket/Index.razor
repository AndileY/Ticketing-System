@page "/ticket"
@using System.Security.Claims
@inject IClient TicketService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<h3 class="fw-bold mb-4">All Tickets</h3>

@if (isLoading)
{
    <p class="text-muted">Loading tickets...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (!tickets.Any())
{
    <p class="text-muted">No tickets found.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var t in tickets)
        {
            <div class="col">
                <div class="card h-100 shadow-sm hover-shadow transition-shadow" style="cursor:pointer;" @onclick="@(() => GoToDetails(t.TicketId))">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@t.Title</h5>
                        <p class="card-text text-muted mb-2">@Shorten(t.Description)</p>

                        <div class="mb-2 d-flex flex-wrap gap-2 text-sm">
                            <span class="badge bg-info text-dark">Category: @GetCategoryName(t.TicketCategoryId)</span>
                            <span class="badge bg-light text-dark">Created: @t.CreatedAt.ToString("yyyy-MM-dd")</span>
                            <span class="badge @(GetStatusBadgeClass(t))">@GetTicketStatus(t)</span>
                        </div>

                        <div class="mt-auto">
                            <button class="btn btn-primary w-100">View Details</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<TicketReadOnlyDto> tickets = new();
    private List<TicketCategoryReadOnlyDto> categories = new();

    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            tickets = (await TicketService.TicketAllAsync()).ToList();
            categories = (await TicketService.TicketCategoryAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load tickets: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string Shorten(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";
        return text.Length <= 80 ? text : text.Substring(0, 80) + "...";
    }

    private string GetCategoryName(int id)
    {
        var cat = categories.FirstOrDefault(c => c.TicketCategoryId == id);
        return cat?.Name ?? "Unknown";
    }

    private void GoToDetails(int ticketId)
    {
        NavigationManager.NavigateTo($"/ticket/details/{ticketId}");
    }

    // ------------------------
    // Status helpers
    private string GetTicketStatus(TicketReadOnlyDto t) =>
        t.ResolvedAt != null ? "Closed" :
        !string.IsNullOrEmpty(t.AssignToUserId) ? "In Progress" :
        "Open";

    private string GetStatusBadgeClass(TicketReadOnlyDto t) =>
        t.ResolvedAt != null ? "bg-success" :
        !string.IsNullOrEmpty(t.AssignToUserId) ? "bg-primary" :
        "bg-warning text-dark";
}


