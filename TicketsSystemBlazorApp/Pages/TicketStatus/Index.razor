@page "/ticketstatus"
@inject IClient ClientService
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3 class="text-2xl font-bold mb-4 text-gray-800">🎫 Ticket Statuses</h3>

@if (statuses == null)
{
    <p class="text-gray-500">Loading ticket statuses...</p>
}
else if (!statuses.Any())
{
    <div class="text-gray-500">No ticket statuses found.</div>
}
else
{
    <div class="mb-4 flex justify-end">
        <a href="/ticketstatus/create" class="bg-green-600 hover:bg-green-700 text-black px-4 py-2 rounded-lg shadow">
            ➕ Create New
        </a>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full border rounded-xl shadow-md bg-white">
            <thead class="bg-gray-100 text-gray-800">
                <tr>
                    <th class="px-4 py-2 text-left">ID</th>
                    <th class="px-4 py-2 text-left">Status</th>
                    <th class="px-4 py-2 text-left">Description</th>
                    <th class="px-4 py-2 text-left">Created</th>
                    <th class="px-4 py-2 text-left">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var status in statuses)
                {
                    <tr class="border-t hover:bg-gray-50">
                        <td class="px-4 py-2">@status.TicketStatusId</td>
                        <td class="px-4 py-2">
                            <span class="inline-block px-2 py-1 rounded-full text-black text-sm @GetStatusColor(status.Status)">
                                @status.Status
                            </span>
                        </td>
                        <td class="px-4 py-2">@status.Description</td>
                        <td class="px-4 py-2">@status.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="px-4 py-2 space-x-2">
                            <a class="bg-blue-600 hover:bg-blue-700 text-black px-3 py-1 rounded shadow text-sm" href="/ticketstatus/update/@status.TicketStatusId" title="Edit status">Edit</a>
                            <a class="bg-teal-500 hover:bg-teal-600 text-black px-3 py-1 rounded shadow text-sm" href="/ticketstatus/details/@status.TicketStatusId" title="View details">Details</a>
                            <button class="bg-red-600 hover:bg-red-700 text-black px-3 py-1 rounded shadow text-sm" @onclick="() => DeleteStatus(status.TicketStatusId)" title="Delete status">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<TicketStatusReadOnly>? statuses;

    protected override async Task OnInitializedAsync()
    {
        statuses = (await ClientService.TicketStatusAllAsync()).ToList();
    }

    private async Task DeleteStatus(int id)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete ticket status #{id}?");
        if (!confirm) return;

        await ClientService.TicketStatusDELETEAsync(id);
        statuses = statuses!.Where(s => s.TicketStatusId != id).ToList();
    }

    // Map status to a color
    private string GetStatusColor(string status) => status.ToLower() switch
    {
        "open" => "bg-yellow-500",
        "in progress" => "bg-blue-500",
        "closed" => "bg-green-500",
        _ => "bg-gray-500"
    };
}


